# Copy this file to `.env` and adjust as needed for local development.

# Database connection string.
# Stage 0 default: local SQLite file (zero setup).
# To move to Postgres later, swap this for something like:
#   postgresql+psycopg2://afl:afl@localhost:5432/afl
DATABASE_URL=sqlite:///./afl.db

# Application environment: local | test | production
APP_ENV=local

# Comma-separated list of origins allowed to call the API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Host/port the API binds to when run via `python -m app.main` (uvicorn CLI overrides these).
API_HOST=127.0.0.1
API_PORT=8000

# Squiggle's usage policy requires a descriptive User-Agent with a contact email.
# Replace with your own contact details if you plan to run ingestion regularly.
SQUIGGLE_USER_AGENT=AFL Analytics Prototype (personal project) - your-email@example.com
